{
  "name": "jord0-hooks",
  "version": "1.0.0",
  "description": "Three Claude Code hooks that stop three real failures: a \"done\" with no test run since the last edit, a delete git cannot give back, and --help on a script nobody read.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Jordo <jordo@jord0.net>",
  "homepage": "https://jord0-cmd.github.io/jord0.hooks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jord0-cmd/jord0.hooks.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "e2e": "node e2e/run.mjs",
    "format": "npx --yes prettier@3.9.9 --write .",
    "format:check": "npx --yes prettier@3.9.9 --check ."
  },
  "dependencies": {
    "tree-sitter-bash": "0.25.1",
    "web-tree-sitter": "0.27.0"
  }
}
