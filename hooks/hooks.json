{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--liftoff-only", "${CLAUDE_PLUGIN_ROOT}/bin/recoverable.mjs"],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": ["--liftoff-only", "${CLAUDE_PLUGIN_ROOT}/bin/flag-probe.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--liftoff-only", "${CLAUDE_PLUGIN_ROOT}/bin/done-gate.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
